{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(scripts/check.sh:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ng build:*)",
      "Bash(npm ci)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(shellcheck:*)",
      "Bash(promtool:*)",
      "Bash(helm lint:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
